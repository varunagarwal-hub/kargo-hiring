# --- AI (Google Gemini) -------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Pinned model id. Change only deliberately: scores are stamped with the model.
GEMINI_MODEL=gemini-3.1-pro-preview

# --- Neon (Postgres + Object Storage) -----------------------------------------
# Locally these are written into .env.local by `neon link` / `neon deploy` /
# `neon env pull`. On Vercel, copy them from there (Project -> Settings -> Env).
# Pooled URL (host contains -pooler): used by the app.
DATABASE_URL=
# Direct URL: used only by `npm run migrate`.
DATABASE_URL_UNPOOLED=
# Branch-scoped S3 credentials for the private "mesa" bucket (neon.ts).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# --- Resend -------------------------------------------------------------------
RESEND_API_KEY=
# Must be an address on a domain you have verified in Resend (Domains page).
# The display name comes from Settings -> Sender name.
RESEND_FROM_EMAIL=hiring@yourdomain.com

# --- Login --------------------------------------------------------------------
# The single founder password.
APP_PASSWORD=
# Random string (>= 32 chars) used to sign the session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
